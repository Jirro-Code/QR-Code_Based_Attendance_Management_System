
{
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
        "/assets/*",
        "/*.js",
        "/*.mjs",
        "/*.css",
        "/*.png",
        "/*.svg",
        "/*.ico",
        "/*.json"
        ]
    },
    "mimeTypes": {
        ".js": "application/javascript",
        ".mjs": "application/javascript",
        ".css": "text/css",
        ".json": "application/json"
    }
}
